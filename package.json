{
  "name": "fnf-after-effects-mcp",
  "version": "0.1.1",
  "description": "Local FNF After Effects MCP with native operations and offline creative skills.",
  "keywords": [
    "adobe",
    "after-effects",
    "aftereffects",
    "claude",
    "extendscript",
    "llm",
    "mcp",
    "model-context-protocol",
    "motion-graphics"
  ],
  "homepage": "https://github.com/higgsfield-ai/fnf-local-pluging-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/higgsfield-ai/fnf-local-pluging-bridge-mcp/issues"
  },
  "license": "SEE LICENSE IN UPSTREAM.md",
  "author": {
    "name": "kumo.productions, Inc.",
    "url": "https://github.com/kumoproductions"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higgsfield-ai/fnf-local-pluging-bridge-mcp.git"
  },
  "bin": {
    "fnf-after-effects": "dist/cli.js",
    "fnf-after-effects-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "jsx",
    "fixtures",
    "LICENSE",
    "README.md",
    "skills",
    "UPSTREAM.md",
    "docs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:jsx": "vitest run tests/lint-jsx.test.ts",
    "docs:tools": "npm run build && node scripts/generate-tools-doc.mjs",
    "docs:tools:check": "npm run build && node scripts/generate-tools-doc.mjs --check",
    "check": "npm run skills:check && npm run typecheck && npm run typecheck:test && npm run lint && npm run format:check && npm run lint:jsx && npm run docs:tools:check",
    "test:offline": "vitest run --exclude \"tests/e2e/**\"",
    "doctor": "node dist/cli.js doctor",
    "skills:manifest": "node scripts/generate-skills-manifest.mjs",
    "skills:check": "node scripts/generate-skills-manifest.mjs --check && python3 scripts/validate-skills.py",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
